{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src",
    "test",
    "api",
    "server",
    "vite.config.ts"
  ]
}
