{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/genesis/child.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/genesis/game.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pitch",
      "destination": "/pitch/",
      "permanent": true
    },
    {
      "source": "/arcade",
      "destination": "/arcade/",
      "permanent": true
    },
    {
      "source": "/genesis",
      "destination": "/genesis/",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/play",
      "destination": "/play/",
      "permanent": true
    },
    {
      "source": "/agent-play",
      "destination": "/agent-play/",
      "permanent": true
    },
    {
      "source": "/runs-feed",
      "destination": "/runs-feed/",
      "permanent": true
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard/",
      "permanent": true
    }
  ],
  "functions": {
    "api/status.mjs": {
      "maxDuration": 60
    },
    "api/rpc.mjs": {
      "maxDuration": 60
    },
    "api/verify-run.mjs": {
      "maxDuration": 60
    },
    "api/runs.mjs": {
      "maxDuration": 60
    },
    "api/runs/*.mjs": {
      "maxDuration": 60
    }
  }
}
