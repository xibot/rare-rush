{
  "name": "rare-rush-testnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run compile && node scripts/run-tests.mjs",
    "test:replay": "node --test test/replay.test.ts",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy": "node scripts/deploy.mjs",
    "verify:run": "node src/sign-run.ts",
    "prepare:operator": "node scripts/prepare-operator.mjs",
    "console": "node scripts/console.mjs",
    "demo": "npm run compile && node scripts/run-tests.mjs --demo"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "hardhat": "3.17.0",
    "solc": "0.8.30",
    "typescript": "6.0.3"
  }
}
